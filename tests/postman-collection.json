{
    "info": {
        "name": "CAB Booking System API",
        "description": "Complete API collection for CAB Booking System with updated schemas",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3000/api",
            "type": "string"
        },
        {
            "key": "accessToken",
            "value": "",
            "type": "string"
        },
        {
            "key": "userId",
            "value": "",
            "type": "string"
        },
        {
            "key": "bookingId",
            "value": "",
            "type": "string"
        },
        {
            "key": "rideId",
            "value": "",
            "type": "string"
        },
        {
            "key": "driverId",
            "value": "",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "1. Authentication",
            "item": [
                {
                    "name": "Register User",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Register successful', () => {",
                                    "    pm.response.to.have.status(201);",
                                    "    const json = pm.response.json();",
                                    "    pm.expect(json.success).to.be.true;",
                                    "    pm.collectionVariables.set('userId', json.data.user.id);",
                                    "    pm.collectionVariables.set('accessToken', json.data.accessToken);",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"username\": \"testuser{{$randomInt}}\",\n  \"password\": \"password123\",\n  \"fullName\": \"Nguyễn Văn Test\",\n  \"phone\": \"090{{$randomInt}}\",\n  \"email\": \"test{{$randomInt}}@example.com\",\n  \"role\": \"PASSENGER\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/register"
                        }
                    }
                },
                {
                    "name": "Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Login successful', () => {",
                                    "    pm.response.to.have.status(200);",
                                    "    const json = pm.response.json();",
                                    "    pm.collectionVariables.set('accessToken', json.data.accessToken);",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"password123\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/login"
                        }
                    }
                }
            ]
        },
        {
            "name": "2. Booking Flow",
            "item": [
                {
                    "name": "Calculate Price",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{accessToken}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"distanceKm\": 5.5,\n  \"durationMin\": 20,\n  \"vehicleType\": \"CAR\",\n  \"pickup\": {\n    \"lat\": 10.762622,\n    \"lng\": 106.660172\n  }\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/pricing/calculate"
                        }
                    }
                },
                {
                    "name": "Create Booking",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Booking created', () => {",
                                    "    pm.response.to.have.status(201);",
                                    "    const json = pm.response.json();",
                                    "    pm.collectionVariables.set('bookingId', json.data.id);",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{accessToken}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"pickup\": {\n    \"lat\": 10.762622,\n    \"lng\": 106.660172,\n    \"address\": \"Quận 1, TP.HCM\"\n  },\n  \"dropoff\": {\n    \"lat\": 10.777730,\n    \"lng\": 106.695416,\n    \"address\": \"Quận 3, TP.HCM\"\n  },\n  \"vehicleType\": \"CAR\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/bookings"
                        }
                    }
                },
                {
                    "name": "Get Booking",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{accessToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/bookings/{{bookingId}}"
                        }
                    }
                }
            ]
        },
        {
            "name": "3. Ride Management",
            "item": [
                {
                    "name": "Create Ride",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Ride created', () => {",
                                    "    pm.response.to.have.status(201);",
                                    "    const json = pm.response.json();",
                                    "    pm.collectionVariables.set('rideId', json.data.id);",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{accessToken}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"bookingId\": \"{{bookingId}}\",\n  \"pickup\": {\n    \"lat\": 10.762622,\n    \"lng\": 106.660172,\n    \"address\": \"Quận 1, TP.HCM\"\n  },\n  \"dropoff\": {\n    \"lat\": 10.777730,\n    \"lng\": 106.695416,\n    \"address\": \"Quận 3, TP.HCM\"\n  },\n  \"vehicleType\": \"CAR\",\n  \"estimatedPrice\": 50000\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/rides"
                        }
                    }
                },
                {
                    "name": "Assign Driver",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{accessToken}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"driverId\": \"{{driverId}}\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/rides/{{rideId}}/assign"
                        }
                    }
                },
                {
                    "name": "Start Ride",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{accessToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/rides/{{rideId}}/start"
                        }
                    }
                },
                {
                    "name": "Complete Ride",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{accessToken}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"actualDistanceKm\": 5.3,\n  \"actualDurationMin\": 18\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/rides/{{rideId}}/complete"
                        }
                    }
                }
            ]
        },
        {
            "name": "4. Drivers",
            "item": [
                {
                    "name": "Get Drivers",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{accessToken}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/drivers?status=ONLINE&vehicleType=CAR",
                            "query": [
                                {
                                    "key": "status",
                                    "value": "ONLINE"
                                },
                                {
                                    "key": "vehicleType",
                                    "value": "CAR"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Create Driver",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Driver created', () => {",
                                    "    pm.response.to.have.status(201);",
                                    "    const json = pm.response.json();",
                                    "    pm.collectionVariables.set('driverId', json.data.id);",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{accessToken}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"name\": \"Lê Văn Driver\",\n  \"phone\": \"091{{$randomInt}}\",\n  \"licenseNumber\": \"B2-12345678\",\n  \"vehicleType\": \"CAR\",\n  \"vehiclePlate\": \"51G-{{$randomInt}}\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/drivers"
                        }
                    }
                }
            ]
        },
        {
            "name": "5. Payment",
            "item": [
                {
                    "name": "Create Payment",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{accessToken}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"rideId\": \"{{rideId}}\",\n  \"amount\": 55000,\n  \"method\": \"CASH\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/payments"
                        }
                    }
                }
            ]
        },
        {
            "name": "6. Review",
            "item": [
                {
                    "name": "Create Review",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{accessToken}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"rideId\": \"{{rideId}}\",\n  \"driverId\": \"{{driverId}}\",\n  \"rating\": 5,\n  \"comment\": \"Excellent service!\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/reviews"
                        }
                    }
                }
            ]
        }
    ]
}