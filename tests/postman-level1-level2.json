{
  "info": {
    "name": "CAB System - Level 1 & 2 (Official 121 Test Cases)",
    "description": "Test cases TC01-TC20 from final_PROJECT_grading-factor.pdf\n\nLevel 1 (TC01-TC10): Basic API & Flow\nLevel 2 (TC11-TC20): Validation & Edge Cases\n\nVào đây: https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "cab-system-121-testcases-L1L2"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "bookingId",
      "value": "",
      "type": "string"
    },
    {
      "key": "driverId",
      "value": "",
      "type": "string"
    },
    {
      "key": "driverToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "idempotencyKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "testEmail",
      "value": "testuser_lvl1@cab.test",
      "type": "string"
    },
    {
      "key": "testPassword",
      "value": "Test@123456",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "=== LEVEL 1 – CƠ BẢN (Basic API & Flow) ===",
      "item": [
        {
          "name": "TC01 – Đăng ký user thành công",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generate unique email to avoid duplicate",
                  "const ts = Date.now();",
                  "pm.collectionVariables.set('testEmail', `tc01_${ts}@cab.test`);",
                  "pm.collectionVariables.set('testPassword', 'Test@123456');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// TC01: Đăng ký user thành công",
                  "pm.test('[TC01] HTTP 201 Created', () => {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('[TC01] Response có success=true', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "});",
                  "",
                  "pm.test('[TC01] Trả về user_id (data.user.id hoặc data.id)', () => {",
                  "    const json = pm.response.json();",
                  "    const userId = json.data?.user?.id || json.data?.id || json.user?.id;",
                  "    pm.expect(userId).to.exist;",
                  "    pm.collectionVariables.set('userId', userId);",
                  "});",
                  "",
                  "pm.test('[TC01] User được lưu DB (có accessToken)', () => {",
                  "    const json = pm.response.json();",
                  "    const token = json.data?.accessToken || json.data?.tokens?.accessToken || json.accessToken;",
                  "    pm.expect(token).to.exist;",
                  "    pm.collectionVariables.set('accessToken', token);",
                  "});",
                  "",
                  "pm.test('[TC01] Không có lỗi validation', () => {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.errors).to.not.exist;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"name\": \"Test User TC01\",\n  \"username\": \"tc01user_{{$randomInt}}\",\n  \"phone\": \"090{{$randomInt}}\",\n  \"role\": \"PASSENGER\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "TC02 – Đăng nhập trả JWT hợp lệ",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// TC02: Login trả JWT hợp lệ",
                  "pm.test('[TC02] HTTP 200 OK', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('[TC02] Trả về access_token (JWT)', () => {",
                  "    const json = pm.response.json();",
                  "    const token = json.data?.accessToken || json.data?.tokens?.accessToken || json.accessToken;",
                  "    pm.expect(token).to.be.a('string').and.not.empty;",
                  "    pm.collectionVariables.set('accessToken', token);",
                  "    const rt = json.data?.refreshToken || json.data?.tokens?.refreshToken || json.refreshToken;",
                  "    if (rt) pm.collectionVariables.set('refreshToken', rt);",
                  "});",
                  "",
                  "pm.test('[TC02] Token decode hợp lệ – có exp và sub', () => {",
                  "    const json = pm.response.json();",
                  "    const token = json.data?.accessToken || json.data?.tokens?.accessToken || json.accessToken;",
                  "    pm.expect(token).to.be.a('string');",
                  "",
                  "    // Decode JWT payload (base64url)",
                  "    const parts = token.split('.');",
                  "    pm.expect(parts.length).to.equal(3, 'JWT must have 3 parts');",
                  "    const payload = JSON.parse(atob(parts[1].replace(/-/g, '+').replace(/_/g, '/')));",
                  "    pm.expect(payload.exp).to.be.a('number', 'exp phải là UNIX timestamp');",
                  "    pm.expect(payload.sub || payload.userId || payload.id).to.exist;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "TC03 – Tạo booking với input hợp lệ",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// TC03: Tạo booking thành công",
                  "pm.test('[TC03] HTTP 200 hoặc 201', () => {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "pm.test('[TC03] Status = REQUESTED hoặc CONFIRMED', () => {",
                  "    const json = pm.response.json();",
                  "    const status = json.data?.status || json.data?.booking?.status;",
                  "    pm.expect(status).to.be.oneOf(['REQUESTED', 'CONFIRMED', 'PENDING']);",
                  "});",
                  "",
                  "pm.test('[TC03] Có booking_id', () => {",
                  "    const json = pm.response.json();",
                  "    const bid = json.data?.id || json.data?.booking_id || json.data?.bookingId;",
                  "    pm.expect(bid).to.exist;",
                  "    pm.collectionVariables.set('bookingId', bid);",
                  "});",
                  "",
                  "pm.test('[TC03] Gọi ETA + Pricing thành công (eta và price hiện diện)', () => {",
                  "    const json = pm.response.json();",
                  "    // May be embedded or separate; just ensure no server error",
                  "    pm.expect(pm.response.code).to.be.lessThan(500);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickup\": { \"lat\": 10.76, \"lng\": 106.66, \"address\": \"Quận 1\" },\n  \"dropoff\": { \"lat\": 10.77, \"lng\": 106.70, \"address\": \"Quận 3\" },\n  \"distance_km\": 5,\n  \"vehicleType\": \"CAR\"\n}"
            },
            "url": "{{baseUrl}}/bookings"
          }
        },
        {
          "name": "TC04 – Lấy danh sách booking của user",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// TC04: GET danh sách bookings",
                  "pm.test('[TC04] HTTP 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('[TC04] Trả về list (array)', () => {",
                  "    const json = pm.response.json();",
                  "    const list = json.data || json.bookings || json;",
                  "    pm.expect(list).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('[TC04] Mỗi item có booking_id và status', () => {",
                  "    const json = pm.response.json();",
                  "    const list = json.data || json.bookings || json;",
                  "    if (Array.isArray(list) && list.length > 0) {",
                  "        const item = list[0];",
                  "        pm.expect(item.id || item.bookingId || item.booking_id).to.exist;",
                  "        pm.expect(item.status).to.exist;",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/bookings?user_id={{userId}}"
          }
        },
        {
          "name": "TC05 – Driver chuyển trạng thái ONLINE",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Use driverToken if set, otherwise fallback to accessToken",
                  "const tok = pm.collectionVariables.get('driverToken') || pm.collectionVariables.get('accessToken');",
                  "pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + tok });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// TC05: Driver set ONLINE",
                  "pm.test('[TC05] HTTP 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('[TC05] Driver status = ONLINE', () => {",
                  "    const json = pm.response.json();",
                  "    const status = json.data?.status || json.status;",
                  "    pm.expect(status).to.equal('ONLINE');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ONLINE\"\n}"
            },
            "url": "{{baseUrl}}/drivers/status"
          }
        },
        {
          "name": "TC06 – Booking tạo xong có status = REQUESTED",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// TC06: GET booking vừa tạo → status = REQUESTED",
                  "pm.test('[TC06] HTTP 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('[TC06] Status ban đầu = REQUESTED (không skip)', () => {",
                  "    const json = pm.response.json();",
                  "    const status = json.data?.status || json.status;",
                  "    pm.expect(status).to.equal('REQUESTED');",
                  "});",
                  "",
                  "pm.test('[TC06] Có timestamp created_at', () => {",
                  "    const json = pm.response.json();",
                  "    const ts = json.data?.created_at || json.data?.createdAt || json.created_at;",
                  "    pm.expect(ts).to.exist;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/bookings/{{bookingId}}"
          }
        },
        {
          "name": "TC07 – ETA API trả về giá trị > 0",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// TC07: AI ETA service",
                  "pm.test('[TC07] HTTP 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('[TC07] eta > 0', () => {",
                  "    const json = pm.response.json();",
                  "    const eta = json.data?.eta || json.eta || json.estimated_time;",
                  "    pm.expect(eta).to.be.a('number').and.greaterThan(0);",
                  "});",
                  "",
                  "pm.test('[TC07] eta hợp lý < 3600 giây (60 phút)', () => {",
                  "    const json = pm.response.json();",
                  "    const eta = json.data?.eta || json.eta || json.estimated_time;",
                  "    pm.expect(eta).to.be.lessThan(3600);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"distance_km\": 5,\n  \"traffic_level\": 0.5\n}"
            },
            "url": "{{baseUrl}}/ai/eta"
          }
        },
        {
          "name": "TC08 – Pricing API trả giá hợp lệ",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// TC08: Pricing service",
                  "pm.test('[TC08] HTTP 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('[TC08] price > base fare (giá > 0)', () => {",
                  "    const json = pm.response.json();",
                  "    const price = json.data?.price || json.data?.total_price || json.price || json.totalPrice;",
                  "    pm.expect(price).to.be.a('number').and.greaterThan(0);",
                  "});",
                  "",
                  "pm.test('[TC08] surge_multiplier >= 1', () => {",
                  "    const json = pm.response.json();",
                  "    const surge = json.data?.surge_multiplier || json.data?.surge || json.surge || json.surgeMultiplier;",
                  "    if (surge !== undefined) {",
                  "        pm.expect(surge).to.be.at.least(1);",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"distance_km\": 5,\n  \"demand_index\": 1.0,\n  \"supply_index\": 1.0,\n  \"vehicleType\": \"CAR\"\n}"
            },
            "url": "{{baseUrl}}/pricing/calculate"
          }
        },
        {
          "name": "TC09 – Notification gửi thành công",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// TC09: Notification service",
                  "pm.test('[TC09] HTTP 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('[TC09] Notification được ghi nhận (success true)', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "});",
                  "",
                  "pm.test('[TC09] Không lỗi timeout (response < 5s)', () => {",
                  "    pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{userId}}\",\n  \"message\": \"Your ride is confirmed\",\n  \"type\": \"BOOKING_CONFIRMED\"\n}"
            },
            "url": "{{baseUrl}}/notifications"
          }
        },
        {
          "name": "TC10 – Logout invalidate token",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('oldToken', pm.collectionVariables.get('accessToken'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// TC10: Logout – token bị invalidate",
                  "pm.test('[TC10] HTTP 200 khi logout', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('[TC10] Response xác nhận logout thành công', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "});",
                  "",
                  "// NOTE: Test tiếp theo (TC10b) sẽ verify 401 khi dùng token cũ"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{baseUrl}}/auth/logout"
          }
        },
        {
          "name": "TC10b – Dùng token cũ sau logout → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[TC10b] Gọi lại với token cũ → HTTP 401', () => {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{oldToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "=== LEVEL 2 – VALIDATION & EDGE CASES ===",
      "item": [
        {
          "name": "[SETUP L2] Đăng ký + Đăng nhập lại",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Tạo email mới cho Level 2 tests",
                  "const ts = Date.now();",
                  "pm.collectionVariables.set('testEmail', `tc_l2_${ts}@cab.test`);",
                  "pm.collectionVariables.set('testPassword', 'Test@123456');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Re-login after TC10 logout",
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    const token = json.data?.accessToken || json.data?.tokens?.accessToken || json.accessToken;",
                  "    if (token) pm.collectionVariables.set('accessToken', token);",
                  "    const uid = json.data?.user?.id || json.data?.id || json.user?.id;",
                  "    if (uid) pm.collectionVariables.set('userId', uid);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"name\": \"Test L2 User\",\n  \"username\": \"tc_l2_{{$randomInt}}\",\n  \"phone\": \"090{{$randomInt}}\",\n  \"role\": \"PASSENGER\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "TC11 – Booking thiếu pickup → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// TC11: Missing required field 'pickup'",
                  "pm.test('[TC11] HTTP 400 Bad Request', () => {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('[TC11] Message chứa \"pickup\" hoặc \"required\"', () => {",
                  "    const text = pm.response.text().toLowerCase();",
                  "    pm.expect(text).to.satisfy(t => t.includes('pickup') || t.includes('required'));",
                  "});",
                  "",
                  "pm.test('[TC11] Không tạo booking (không có booking_id)', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data?.id || json.booking_id).to.not.exist;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dropoff\": { \"lat\": 10.77, \"lng\": 106.70 },\n  \"distance_km\": 5\n}"
            },
            "url": "{{baseUrl}}/bookings"
          }
        },
        {
          "name": "TC12 – Sai format lat/lng → 422",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// TC12: Invalid data type (string instead of float)",
                  "pm.test('[TC12] HTTP 422 Unprocessable Entity (hoặc 400)', () => {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 422]);",
                  "});",
                  "",
                  "pm.test('[TC12] Có validation error message', () => {",
                  "    const text = pm.response.text().toLowerCase();",
                  "    pm.expect(text).to.satisfy(t =>",
                  "        t.includes('lat') || t.includes('invalid') || t.includes('validation') || t.includes('number')",
                  "    );",
                  "});",
                  "",
                  "pm.test('[TC12] Không gọi AI services (no 200 from AI)', () => {",
                  "    pm.expect(pm.response.code).to.not.equal(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickup\": { \"lat\": \"abc\", \"lng\": 106.66 },\n  \"dropoff\": { \"lat\": 10.77, \"lng\": 106.70 },\n  \"distance_km\": 5\n}"
            },
            "url": "{{baseUrl}}/bookings"
          }
        },
        {
          "name": "TC13 – Driver offline không nhận booking → PENDING/FAILED",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// TC13: No driver available in area",
