# ========================================
# COMMON CONFIGURATION
# ========================================
NODE_ENV=development
LOG_LEVEL=info
LOG_FORMAT=json
TIMEZONE=Asia/Ho_Chi_Minh

# ========================================
# JWT & SECURITY
# ========================================
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_change_in_production

# ========================================
# DATABASES
# ========================================
# PostgreSQL - Auth Service
AUTH_DB_HOST=localhost
AUTH_DB_PORT=5432
AUTH_DB_NAME=auth_db
AUTH_DB_USER=admin
AUTH_DB_PASSWORD=admin123

# PostgreSQL - Main Database (User, Driver, Booking, Payment)
MAIN_DB_HOST=localhost
MAIN_DB_PORT=5433
MAIN_DB_NAME=main_db
MAIN_DB_USER=admin
MAIN_DB_PASSWORD=admin123

# MongoDB - Ride & Review Services
MONGODB_URI=mongodb://admin:admin123@localhost:27017/?authSource=admin
MONGODB_RIDE_DB=ride_db
MONGODB_REVIEW_DB=review_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=3600

# ========================================
# KAFKA / EVENT BUS
# ========================================
KAFKA_BROKER=localhost:9092
KAFKA_CLIENT_ID=cab-booking-system
KAFKA_GROUP_ID=cab-booking-group

# ========================================
# MICROSERVICES URLs (For Docker)
# ========================================
# API Gateway sẽ sử dụng các URL này khi chạy trong Docker
AUTH_SERVICE_URL=http://auth-service:3001
USER_SERVICE_URL=http://user-service:3002
DRIVER_SERVICE_URL=http://driver-service:3003
BOOKING_SERVICE_URL=http://booking-service:3004
RIDE_SERVICE_URL=http://ride-service:3005
PAYMENT_SERVICE_URL=http://payment-service:3006
PRICING_SERVICE_URL=http://pricing-service:3007
REVIEW_SERVICE_URL=http://review-service:3008
NOTIFICATION_SERVICE_URL=http://notification-service:3009

# ========================================
# EXTERNAL SERVICES
# ========================================
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
STRIPE_SECRET_KEY=sk_test_your_stripe_key
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
MOMO_SECRET_KEY=your_momo_secret_key

# ========================================
# CORS
# ========================================
CORS_ORIGIN=*
CORS_CREDENTIALS=true