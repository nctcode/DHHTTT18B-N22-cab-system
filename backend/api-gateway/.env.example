# Server
PORT=3000
NODE_ENV=production

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_ACCESS_SECRET=your-access-token-secret-here-change-in-production
JWT_REFRESH_SECRET=your-refresh-token-secret-here-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=*

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

#Encryption
ENCRYPTION_KEY=your-encryption-key-here-change-in-production

# Microservices URLs (Docker)
AUTH_SERVICE_URL=http://auth-service:3001
USER_SERVICE_URL=http://user-service:3002
DRIVER_SERVICE_URL=http://driver-service:3003
RIDE_SERVICE_URL=http://ride-service:3005
BOOKING_SERVICE_URL=http://booking-service:3004
PAYMENT_SERVICE_URL=http://payment-service:3006
PRICING_SERVICE_URL=http://pricing-service:3007
NOTIFICATION_SERVICE_URL=http://notification-service:3008
REVIEW_SERVICE_URL=http://review-service:3009
AI_MATCHING_URL=http://ai-matching-service:4001
AI_ETA_URL=http://ai-eta-service:4002
AI_SURGE_URL=http://ai-surge-service:4003
FEATURE_STORE_URL=http://feature-store-service:4020
MODEL_SERVING_URL=http://model-serving-service:4010
ML_TRAINING_URL=http://ml-training-service:4030

# Service API Keys (for service-to-service auth)
BOOKING_SERVICE_API_KEY=your-booking-service-key-here
RIDE_SERVICE_API_KEY=your-ride-service-key-here
DRIVER_SERVICE_API_KEY=your-driver-service-key-here
PAYMENT_SERVICE_API_KEY=your-payment-service-key-here
NOTIF_SERVICE_API_KEY=your-notification-service-key-here

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Circuit Breaker Settings
CIRCUIT_BREAKER_TIMEOUT=5000
CIRCUIT_BREAKER_ERROR_THRESHOLD=50
CIRCUIT_BREAKER_RESET_TIMEOUT=30000

# Retry Settings
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=100
