# User Service Configuration

# Server
PORT=5003
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cab_user_service

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth Service
AUTH_SERVICE_URL=http://localhost:4001
JWT_SECRET=your-jwt-secret-key-same-as-auth-service

# Service Settings
SERVICE_NAME=user-service